# mlflow settings
MLFLOW_SERVICE_PORT=5000
MLFLOW_ALLOWED_HOSTS="mlflow_service:*,localhost:*,127.0.0.1:*"
MLFLOW_INTERVAL=5s
MLFLOW_TIMEOUT=10s
MLFLOW_RETRIES=5
MLFLOW_START_PERIOD=20s
MLFLOW_VERSION=v3.11.1-full
MLFLOW_SERVICE_NAME=mlflow_service
MLFLOW_TRACKING_URI=http://$MLFLOW_SERVICE_NAME:$MLFLOW_SERVICE_PORT
MLFLOW_EXPERIMENT_NAME=Financial_Assistant_Experiment

# advisor agent settings
ADVISOR_AGENT_PORT=8000

# market intelligence unit settings
MIU_PORT=8001